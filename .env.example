# Copy this to .env and fill in your values.
# For a deployed Worker, set these as Wrangler vars/secrets instead.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Set to true to run fully offline against local fixture data instead of real
# API calls. Runs the full agent flow (delegation, scoring, reporting) with no
# credentials. Leave unset (or false) for live mode.
FIXTURE_MODE=true

# Model specifier — two contexts:
#   Local (flue run):     MODEL=openai/gpt-4o             (uses OPENAI_API_KEY)
#   Deployed (CF Worker): MODEL=cloudflare/openai/gpt-4o  (routes through the
#                         Worker AI binding / AI Gateway, no key needed)
MODEL=openai/gpt-4o

# Required when MODEL=openai/gpt-4o (local dev).
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare API + Logs Engine  (only needed in live mode, i.e. FIXTURE_MODE unset)
# One API token with: Account Intel Read, Zero Trust Read, Logs Read + Edit.
# NOTE: the Logs Engine /logs/retrieve endpoint documents token auth as needing
# Logs *Edit* (Logpull), even though retrieval is read-only. Confirm vs. your account.
# ---------------------------------------------------------------------------
CF_API_TOKEN=
CF_ACCOUNT_ID=

# R2 credentials for Logs Engine (Logpush -> R2) retrieval.
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# R2 bucket + per-dataset Logpush prefixes (defaults shown; override if your
# Logpush jobs write elsewhere). NOTE: the {DATE} token must match how your
# Logpush jobs partition objects — confirm against your own job config.
CF_LOG_BUCKET=zt-investigator-logs
# CF_GATEWAY_DNS_PREFIX=gateway_dns/{DATE}
# CF_GATEWAY_HTTP_PREFIX=gateway_http/{DATE}

# ---------------------------------------------------------------------------
# Cloudforce One threat events  (OPTIONAL — enrichment is skipped when unset)
# Requires a Cloudforce One subscription. Token needs Cloudforce One Read.
# ---------------------------------------------------------------------------
CLOUDFORCE_ONE_API_TOKEN=
# Dataset(s) to query for attributed threat events. 'all' searches every
# event dataset in the account (default).
# CF_CLOUDFORCE_ONE_DATASET=all

# ---------------------------------------------------------------------------
# Slack  (ingress + report delivery)
# Missing SLACK_SIGNING_SECRET => webhook verification fails closed.
# Missing SLACK_BOT_TOKEN      => reports fall back to run output.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
