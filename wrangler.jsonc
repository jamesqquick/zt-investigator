{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zt-investigator",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "MODEL": "cloudflare/openai/gpt-4o"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FlueZeroTrustInvestigatorAgent"]
    }
  ]
}
